# Sao chép file này thành .env.local rồi điền giá trị (KHÔNG commit .env.local)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...) hoặc service_role.
# CHỈ dùng phía server. Tuyệt đối không đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Tên miền nội bộ dùng cho tài khoản chỉ có số điện thoại (không gửi mail tới địa chỉ này)
AUTH_PHONE_EMAIL_DOMAIN=sdt.bomyden.invalid

# Thông báo đẩy (Web Push) — khóa công khai, do "npm run push:setup" tạo và tự ghi vào .env.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
